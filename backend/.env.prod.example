# GeoForraje Backend - Variables de entorno PRODUCCIÓN
# Copiar a .env.prod y completar valores reales

# Database
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/geoforraje
POSTGRES_DB=geoforraje
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# JWT (clave mínima 32 caracteres, generar con: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (dominio de producción)
CORS_ORIGINS=["https://geoforraje.example.com"]

# Raster data path (volumen montado)
RASTER_DATA_PATH=/data/rasters

# Redis (Celery)
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO

# Monitoring (opcional)
SENTRY_DSN=

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME
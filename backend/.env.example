# GeoForraje Backend - Variables de entorno (ejemplo)
# Copiar a .env y modificar valores

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/geoforraje

# JWT
JWT_SECRET=tu-clave-secreta-super-larga-y-segura-minimo-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Raster data path (montado como volume en docker-compose)
RASTER_DATA_PATH=/data/rasters

# Log level
LOG_LEVEL=INFO